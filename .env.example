# Google Cloud & CX Agent Studio (GECX) configuration (required only for cloud deployment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
CLOUD_RUN_REGION=europe-west1
CXAS_LOCATION=eu
CXAS_APP_NAME=projects/your-gcp-project-id/locations/eu/apps/your-app-id
SA_EMAIL=gecx-temporal-sa@your-gcp-project-id.iam.gserviceaccount.com

# Optional Identity-Aware Proxy (IAP) settings for scripts/deploy_ui.sh
IAP_DOMAINS=example.com
IAP_OAUTH_CLIENT_ID=
IAP_OAUTH_SECRET_NAME=

# Optional external Temporal Server / Temporal Cloud connection
# (leave empty to use the embedded Temporal server)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS=
TEMPORAL_TASK_QUEUE=albion-dispute-task-queue
TEMPORAL_UPDATE_TIMEOUT_SEC=2.5
